generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String             @id @default(uuid())
  username                 String?
  email                    String             @unique
  password                 String
  avatar                   String?
  bio                      String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  blogs                    Blog[]
  series                   Series[]
  comments                 Comment[]
  images                   Image[]
  likes                    Like[]
  bookmarks                Bookmark[]
  subscriptionsAsPublisher Subscription[]     @relation("publisher")
  subscriptionsAsReader    Subscription[]     @relation("reader")
  InterestedTopics         InterestedTopics[]
  Notifications            Notifications?     @relation("notifications")
}

model Series {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blogs     Blog[]

  @@unique([ownerId, title])
}

model Blog {
  id          String      @id @default(uuid())
  ownerId     String
  content     Json
  title       String
  headline    String?
  slug        String?     @unique
  description String?
  coverUrl    String?
  publishAt   DateTime?
  seriesId    String?
  status      Status
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       User        @relation(fields: [ownerId], references: [id])
  series      Series?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  comments    Comment[]
  images      Image[]
  likes       Like[]
  bookmarks   Bookmark[]
  tags        Tag[]
  blogvisit   BlogVisit[]
}

model Bookmark {
  id        String   @id @default(uuid())
  ownerId   String
  blogId    String
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id])
  blog      Blog     @relation(fields: [blogId], references: [id])

  @@unique([ownerId, blogId])
}

model Tag {
  id               String             @id @default(uuid())
  blogId           String
  tag              String
  blog             Blog               @relation(fields: [blogId], references: [id])
  InterestedTopics InterestedTopics[]
}

model InterestedTopics {
  id     String @id @default(uuid())
  tagId  String
  userId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  ownerId   String
  blogId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id])
  owner     User     @relation(fields: [ownerId], references: [id])
}

model Like {
  id        String   @id @default(uuid())
  ownerId   String
  blogId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id])
  owner     User     @relation(fields: [ownerId], references: [id])
}

model Subscription {
  id          String   @id @default(uuid())
  publisherId String
  readerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publisher   User     @relation("publisher", fields: [publisherId], references: [id])
  reader      User     @relation("reader", fields: [readerId], references: [id])
}

model Image {
  id       String @id @default(uuid())
  imageUrl String
  ownerId  String
  blogId   String
  blog     Blog   @relation(fields: [blogId], references: [id])
  owner    User   @relation(fields: [ownerId], references: [id])
}

model Notifications {
  id              String  @id @default(uuid())
  userId          String  @unique
  publisherEmails Boolean @default(true)
  socialEmails    Boolean @default(false)
  marketingEmails Boolean @default(true)
  securityEmails  Boolean @default(true)
  user            User    @relation("notifications", fields: [userId], references: [id])
}

enum Status {
  Published
  Draft
  Scheduled
}

model ContactUs {
  id        String   @id @default(uuid())
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogVisit {
  id        String   @id @default(uuid())
  blogId    String
  ipAddress String
  userAgent String
  visitedAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])
}
