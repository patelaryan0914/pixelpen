generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                       String             @id @default(uuid())
  username                 String?
  email                    String             @unique
  password                 String
  avatar                   String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  blogs                    Blog[]
  comments                 Comment[]
  images                   Image[]
  likes                    Like[]
  subscriptionsAsPublisher Subscription[]     @relation("publisher")
  subscriptionsAsReader    Subscription[]     @relation("reader")
  InterestedTopics         InterestedTopics[]
  Notifications            Notifications?     @relation("notifications")
}

model Blog {
  id        String      @id @default(uuid())
  ownerId   String
  content   Json
  title     String
  status    Status
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  owner     User        @relation(fields: [ownerId], references: [id])
  comments  Comment[]
  images    Image[]
  likes     Like[]
  tags      Tag[]
  blogvisit BlogVisit[]
}

model Tag {
  id               String             @id @default(uuid())
  blogId           String
  tag              String
  blog             Blog               @relation(fields: [blogId], references: [id])
  InterestedTopics InterestedTopics[]
}

model InterestedTopics {
  id     String @id @default(uuid())
  tagId  String
  userId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  ownerId   String
  blogId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id])
  owner     User     @relation(fields: [ownerId], references: [id])
}

model Like {
  id        String   @id @default(uuid())
  ownerId   String
  blogId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id])
  owner     User     @relation(fields: [ownerId], references: [id])
}

model Subscription {
  id          String   @id @default(uuid())
  publisherId String
  readerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publisher   User     @relation("publisher", fields: [publisherId], references: [id])
  reader      User     @relation("reader", fields: [readerId], references: [id])
}

model Image {
  id       String @id @default(uuid())
  imageUrl String
  ownerId  String
  blogId   String
  blog     Blog   @relation(fields: [blogId], references: [id])
  owner    User   @relation(fields: [ownerId], references: [id])
}

model Notifications {
  id              String  @id @default(uuid())
  userId          String  @unique
  publisherEmails Boolean @default(true)
  socialEmails    Boolean @default(false)
  marketingEmails Boolean @default(true)
  securityEmails  Boolean @default(true)
  user            User    @relation("notifications", fields: [userId], references: [id])
}

enum Status {
  Published
  Draft
}

model ContactUs {
  id        String   @id @default(uuid())
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogVisit {
  id        String   @id @default(uuid())
  blogId    String
  ipAddress String
  userAgent String
  visitedAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])
}
