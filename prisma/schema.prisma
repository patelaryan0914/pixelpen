generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                       String         @id @default(uuid())
  username                 String?
  email                    String         @unique
  password                 String
  avatar                   String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  blogs                    Blog[]
  comments                 Comment[]
  images                   Image[]
  likes                    Like[]
  subscriptionsAsPublisher Subscription[] @relation("publisher")
  subscriptionsAsReader    Subscription[] @relation("reader")
}

model Blog {
  id        String    @id @default(uuid())
  ownerId   String
  content   Json
  title     String
  status    Status
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  owner     User      @relation(fields: [ownerId], references: [id])
  comments  Comment[]
  images    Image[]
  likes     Like[]
  tags      Tag[]
}

model Tag {
  id     String @id @default(uuid())
  blogId String
  tag    String
  blog   Blog   @relation(fields: [blogId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  ownerId   String
  blogId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id])
  owner     User     @relation(fields: [ownerId], references: [id])
}

model Like {
  id        String   @id @default(uuid())
  ownerId   String
  blogId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id])
  owner     User     @relation(fields: [ownerId], references: [id])
}

model Subscription {
  id          String   @id @default(uuid())
  publisherId String
  readerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publisher   User     @relation("publisher", fields: [publisherId], references: [id])
  reader      User     @relation("reader", fields: [readerId], references: [id])
}

model Image {
  id       String @id @default(uuid())
  imageUrl String
  ownerId  String
  blogId   String
  blog     Blog   @relation(fields: [blogId], references: [id])
  owner    User   @relation(fields: [ownerId], references: [id])
}

enum Status {
  Published
  Draft
}
